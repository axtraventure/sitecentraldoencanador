# Central do Encanador - Configurações Apache (.htaccess)

# Charset padrão UTF-8
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Forçar HTTPS (HTTP -> HTTPS, código 301)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Redirecionar www para sem www (código 301)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
</IfModule>

# 3) Página 404 redirecionando para One Page
ErrorDocument 404 /index.html

# 4) Compressão Gzip (HTML, CSS, JS, SVG, JSON)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml
</IfModule>

# 5) Cache de Navegador (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: sem cache
  ExpiresByType text/html "access plus 0 seconds"

  # CSS e JavaScript: 1 dia
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"

  # Imagens: 1 mês
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Padrão
  ExpiresDefault "access plus 1 month"
</IfModule>

# Controle de Cache adicional via mod_headers
<IfModule mod_headers.c>
  # HTML: no-cache, must-revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Headers de Segurança
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
